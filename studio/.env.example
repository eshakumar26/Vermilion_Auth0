# Copy this file to .env (same folder) and fill in the values.
# .env is in .gitignore: it must never be committed, pasted in chat, or shown on screen.

# Your Auth0 tenant (same as Payouts)
ISSUER_BASE_URL=https://dev-dbkz3kyytfvcym68.us.auth0.com

# From Auth0 > Applications > Vermilion Studio (Settings tab). Not secret.
CLIENT_ID=paste-the-Studio-client-id-here

# From the Credentials tab of Vermilion Studio (Copy button). SECRET: never share it.
CLIENT_SECRET=paste-the-Studio-client-secret-here

# Studio's own cookie-encryption key (NOT the Auth0 client secret, NOT Payouts'). Make one in Terminal with:
#   openssl rand -hex 32
SECRET=paste-the-output-of-openssl-here

BASE_URL=http://localhost:3000
PORT=3000
PAYOUTS_URL=http://localhost:3001
