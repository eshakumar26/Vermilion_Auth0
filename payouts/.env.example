# Copy this file to .env (same folder) and fill in the values.
# .env is in .gitignore: it must never be committed, pasted in chat, or shown on screen.

# Your Auth0 tenant (same as Studio)
ISSUER_BASE_URL=https://dev-dbkz3kyytfvcym68.us.auth0.com

# From Auth0 > Applications > Vermilion Payouts (Settings tab). Not secret.
CLIENT_ID=paste-the-Payouts-client-id-here

# From the Credentials tab of Vermilion Payouts (Copy button). SECRET: never share it.
CLIENT_SECRET=paste-the-Payouts-client-secret-here

# Payouts' own cookie-encryption key (NOT Studio's). Make one in Terminal with:
#   openssl rand -hex 32
SECRET=paste-the-output-of-openssl-here

BASE_URL=http://localhost:3001
PORT=3001
STUDIO_URL=http://localhost:3000
STEP_UP_MAX_AGE_MINUTES=10

# Payout hold after an account change, in days (D-037)
PAYOUT_HOLD_DAYS=5

# Idle lock: minutes with no activity in Payouts before the artist must log in again (D-038).
# Set to 1 to test without waiting, then back to 15.
PAYOUTS_IDLE_MINUTES=15
